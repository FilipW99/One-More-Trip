{
  "name": "one-more-trip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One More Trip: a short-run roguelike with tick-based combat and long-term meta progression.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "placeholders": "tsx scripts/placeholder-report.ts",
    "sim": "tsx scripts/simulate.ts",
    "check": "tsc --noEmit && vitest run && tsx scripts/placeholder-report.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
